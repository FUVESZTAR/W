// ── Google Drive config ──────────────────────────────────────────────
// Fill these in once.
// 1. Create an API key in Google Cloud Console, enable the Drive API,
//    restrict the key to Drive API (+ HTTP referrer = your domain).
// 2. Create one folder in Drive named e.g. "plantImage", share it as
//    "Anyone with the link — Viewer", copy its folder ID from the URL.
// 3. Upload images into that single folder, named like:
//    malus_domestica_gala_1.jpg, malus_domestica_gala_2.jpg, ...
//    i.e. normalizeName(LatinName + "_" + Name_Variety) + "_" + running number
const DRIVE_API_KEY     = 'YOUR_API_KEY_HERE';
const DRIVE_FOLDER_ID   = 'YOUR_PLANTIMAGE_FOLDER_ID_HERE';
const DRIVE_API_BASE    = 'https://www.googleapis.com/drive/v3/files';

function driveImageUrl(fileId, size = 'w1000') {
  return `https://drive.google.com/thumbnail?id=${fileId}&sz=${size}`;
}

// Fetch the full file list for the flat plantImage folder once, then
// reuse it for every plant lookup in this session.
let _driveFileListPromise = null;
async function getDriveFileList() {
  if (_driveFileListPromise) return _driveFileListPromise;

  _driveFileListPromise = (async () => {
    let files = [];
    let pageToken = '';
    do {
      const q = encodeURIComponent(
        `'${DRIVE_FOLDER_ID}' in parents and mimeType contains 'image/' and trashed = false`
      );
      const url = `${DRIVE_API_BASE}?q=${q}&fields=nextPageToken,files(id,name)&pageSize=1000&key=${DRIVE_API_KEY}${pageToken ? `&pageToken=${pageToken}` : ''}`;
      const res = await fetch(url);
      if (!res.ok) throw new Error(`Drive file listing failed: ${res.status}`);
      const data = await res.json();
      files = files.concat(data.files || []);
      pageToken = data.nextPageToken || '';
    } while (pageToken);
    console.log(`Drive: cached ${files.length} file(s) from plantImage folder`);
    return files;
  })();

  return _driveFileListPromise;
}

async function loadPlantImage(plant) {
  carouselInit();
  const searchLatin   = (plant.LatinName   || '').trim().replace(/\s+/g, '_');
  const searchVariety = (plant.Name_Variety || '').trim().replace(/\s+/g, '_');
  const imgText  = `${searchLatin}_${searchVariety}`;
  const searchId = normalizeName(imgText);   // e.g. "malus_domestica_gala"
  console.log('search image norm text: ' + searchId);

  _carouselImages = [];
  _carouselIndex  = 0;

  // 1. Try Google Drive — flat folder, filter by LatinName_Variety key
  try {
    const files = await getDriveFileList();
    const matches = files.filter(f => normalizeName(f.name).includes(searchId));

    if (matches.length) {
      _carouselImages = matches.map(f => ({
        src:  driveImageUrl(f.id),
        name: extractImageName(f.name),
      }));
      console.log(`found ${_carouselImages.length} Drive image(s) for key "${searchId}"`);
      carouselRender();
      return;
    }
  } catch (err) {
    console.warn('Google Drive image lookup failed:', err);
  }

  // 2. Fallback to Wikipedia
  try {
    const wikiResponse = await fetch(`https://en.wikipedia.org/api/rest_v1/page/summary/${searchLatin}`);
    if (!wikiResponse.ok) throw new Error('Wiki fetch failed');
    const wikiData = await wikiResponse.json();
    const src = wikiData.thumbnail?.source || wikiData.originalimage?.source || null;
    if (src) {
      _carouselImages = [{ src, name: extractImageName(src) }];
      carouselRender();
      return;
    }
  } catch (err) {
    console.warn('Wikipedia image fetch failed:', err);
  }

  // 3. Default placeholder
  _carouselImages = [{ src: 'images/default.jpg', name: 'Default image' }];
  carouselRender();
}
